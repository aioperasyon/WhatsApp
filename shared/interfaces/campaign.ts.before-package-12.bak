export type CampaignStatus =
  | 'draft'
  | 'ready'
  | 'scheduled'
  | 'running'
  | 'paused'
  | 'completed'
  | 'cancelled'
  | 'failed';

export type CampaignRecipientStatus =
  | 'pending'
  | 'sending'
  | 'sent'
  | 'failed'
  | 'cancelled';

export interface CampaignSettings {
  description: string | null;
  minDelaySeconds: number;
  maxDelaySeconds: number;
  batchSize: number;
  batchPauseMinSeconds: number;
  batchPauseMaxSeconds: number;
  dailyLimit: number | null;
  workStartTime: string;
  workEndTime: string;
  typingSimulation: boolean;
  retryCount: number;
  scheduledAt: string | null;
}

export interface Campaign {
  id: string;
  name: string;
  accountId: string | null;
  accountName: string | null;
  message: string;
  sectors: string[];
  cities: string[];
  onlyAllowed: boolean;
  estimatedRecipients: number;
  status: CampaignStatus;
  totalRecipients: number;
  sentCount: number;
  failedCount: number;
  pendingCount: number;
  startedAt: string | null;
  completedAt: string | null;
  createdAt: string;
  updatedAt: string;
  settings: CampaignSettings;
}

export interface CampaignListRequest {
  search?: string;
  limit?: number;
  offset?: number;
}

export interface CampaignSnapshot {
  campaigns: Campaign[];
  total: number;
}

export interface CampaignSaveInput {
  id?: string;
  name: string;
  accountId?: string | null;
  message: string;
  sectors?: string[];
  cities?: string[];
  onlyAllowed?: boolean;
  status?: 'draft' | 'ready' | 'scheduled';
  description?: string | null;
  minDelaySeconds?: number;
  maxDelaySeconds?: number;
  batchSize?: number;
  batchPauseMinSeconds?: number;
  batchPauseMaxSeconds?: number;
  dailyLimit?: number | null;
  workStartTime?: string;
  workEndTime?: string;
  typingSimulation?: boolean;
  retryCount?: number;
  scheduledAt?: string | null;
}

export interface CampaignDeleteRequest {
  id: string;
}

export interface CampaignDeleteResult {
  deleted: boolean;
}

export interface CampaignAudienceRequest {
  sectors?: string[];
  cities?: string[];
  onlyAllowed?: boolean;
}

export interface CampaignAudienceEstimate {
  total: number;
  sectors: string[];
  cities: string[];
}

export interface CampaignActionRequest {
  id: string;
}

export interface CampaignActionResult {
  campaign: Campaign;
  message: string;
}

export interface CampaignRecipientLog {
  id: string;
  campaignId: string;
  contactId: string;
  fullName: string;
  phoneNumber: string;
  status: CampaignRecipientStatus;
  attemptCount: number;
  errorMessage: string | null;
  whatsappMessageId: string | null;
  sentAt: string | null;
  updatedAt: string;
}

export interface CampaignRecipientLogRequest {
  campaignId: string;
  limit?: number;
  offset?: number;
}

export interface CampaignRecipientLogSnapshot {
  recipients: CampaignRecipientLog[];
  total: number;
}
