let campaignSchedulerShutdownRegistered = false;

const IPC_CHANNELS = {
  list: 'campaigns:list',
  save: 'campaigns:save',
  delete: 'campaigns:delete',
  estimate: 'campaigns:estimate-audience',
  analyze: 'campaigns:analyze-audience',
