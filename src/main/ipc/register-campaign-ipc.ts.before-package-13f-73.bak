}

function reportCampaignFailureConcentration(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        campaign_id,
        COUNT(*) AS total_count,
        SUM(CASE WHEN status='failed' THEN 1 ELSE 0 END) AS failed_count
      FROM campaign_recipients
      GROUP BY campaign_id
      HAVING COUNT(*) >= 10
      ORDER BY
        CAST(SUM(CASE WHEN status='failed' THEN 1 ELSE 0 END) AS REAL) / COUNT(*) DESC
      LIMIT 1
    `).get() as {
      campaign_id:string|number|null;
      total_count:number|null;
      failed_count:number|null;
    } | undefined;

    if(!row){
      console.info('[Campaign Engine] Hata yoğunluğu: değerlendirme için yeterli kampanya verisi yok.');
      return;
    }

    const campaignId=String(row.campaign_id??'bilinmiyor');
    const total=Number(row.total_count??0);
    const failed=Number(row.failed_count??0);
    const ratio=total>0?failed/total:0;

    console.info(
      `[Campaign Engine] En yüksek hata yoğunluğu: kampanya=${campaignId}, başarısız=${failed}, toplam=${total}, oran=%${(ratio*100).toFixed(2)}.`
    );

    if(failed>=5 && ratio>=0.25){
      console.warn(
        `[Campaign Engine] Kampanya ${campaignId} için yüksek hata yoğunluğu tespit edildi.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Hata yoğunluğu kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

