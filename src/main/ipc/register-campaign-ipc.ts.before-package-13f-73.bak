function reportCampaignRetrySuccessSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(
          CASE
            WHEN COALESCE(retry_count,0)>0
             AND status IN ('sent','delivered','read')
            THEN 1 ELSE 0
          END
        ) AS retry_success_count,
        SUM(
          CASE
            WHEN COALESCE(retry_count,0)>0
             AND status='failed'
            THEN 1 ELSE 0
          END
        ) AS retry_failed_count,
        SUM(
          CASE
            WHEN COALESCE(retry_count,0)>0
            THEN 1 ELSE 0
          END
        ) AS retried_total
      FROM campaign_recipients
    `).get() as {
      retry_success_count:number|null;
      retry_failed_count:number|null;
      retried_total:number|null;
    };

    const success=Number(row.retry_success_count??0);
    const failed=Number(row.retry_failed_count??0);
    const total=Number(row.retried_total??0);
    const resolved=success+failed;
    const successRatio=resolved>0?success/resolved:0;

    console.info(
      `[Campaign Engine] Retry sonucu: retry alan=${total}, başarılı=${success}, başarısız=${failed}, başarı oranı=%${(successRatio*100).toFixed(2)}.`
    );

    if(resolved>=10 && successRatio<0.40){
      console.warn(
        '[Campaign Engine] Retry işlemlerinin başarı oranı düşük görünüyor.'
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Retry başarı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignRetryLoadSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        COUNT(*) AS total_count,
        SUM(CASE WHEN COALESCE(retry_count,0)>0 THEN 1 ELSE 0 END) AS retried_count,
