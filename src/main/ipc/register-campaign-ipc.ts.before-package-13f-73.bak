function reportCampaignActiveAgeBuckets(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(
          CASE
            WHEN status IN ('pending','sending')
             AND COALESCE(updated_at,created_at)>=datetime('now','-15 minutes')
            THEN 1 ELSE 0
          END
        ) AS age_0_15,
        SUM(
          CASE
            WHEN status IN ('pending','sending')
             AND COALESCE(updated_at,created_at)<datetime('now','-15 minutes')
             AND COALESCE(updated_at,created_at)>=datetime('now','-1 hour')
            THEN 1 ELSE 0
          END
        ) AS age_15_60,
        SUM(
          CASE
            WHEN status IN ('pending','sending')
             AND COALESCE(updated_at,created_at)<datetime('now','-1 hour')
             AND COALESCE(updated_at,created_at)>=datetime('now','-6 hours')
            THEN 1 ELSE 0
          END
        ) AS age_1_6_hours,
        SUM(
          CASE
            WHEN status IN ('pending','sending')
             AND COALESCE(updated_at,created_at)<datetime('now','-6 hours')
            THEN 1 ELSE 0
          END
        ) AS age_over_6_hours
      FROM campaign_recipients
    `).get() as {
      age_0_15:number|null;
      age_15_60:number|null;
      age_1_6_hours:number|null;
      age_over_6_hours:number|null;
    };

    const fresh=Number(row.age_0_15??0);
    const warm=Number(row.age_15_60??0);
    const old=Number(row.age_1_6_hours??0);
    const stale=Number(row.age_over_6_hours??0);

    console.info(
      `[Campaign Engine] Aktif kayıt yaş dağılımı: 0-15dk=${fresh}, 15-60dk=${warm}, 1-6sa=${old}, 6sa+=${stale}.`
    );

    if(stale>0){
      console.warn(
        `[Campaign Engine] Altı saatten uzun süredir aktif kalan alıcı kaydı tespit edildi: ${stale}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Aktif kayıt yaş dağılımı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignAverageRetryPerFailure(): void {
  const db=getDatabase();
  try{
    const row=db.prepare(`
      SELECT
        SUM(COALESCE(retry_count,0)) AS retry_sum,
        SUM(CASE WHEN status='failed' THEN 1 ELSE 0 END) AS failed_count
      FROM campaign_recipients
    `).get() as {
      retry_sum:number|null;
      failed_count:number|null;
    };

    const retrySum=Number(row.retry_sum??0);
    const failed=Number(row.failed_count??0);
    const average=failed>0?retrySum/failed:0;

    console.info(
      `[Campaign Engine] Başarısız kayıt başına ortalama retry=${average.toFixed(2)} (retry=${retrySum}, failed=${failed}).`
    );

    if(failed>=10 && average>=3){
      console.warn('[Campaign Engine] Başarısız kayıtlar için retry yükü yüksek görünüyor.');
    }
  }catch(reason){
    const message=reason instanceof Error?reason.message:'Retry ortalaması kontrolü başarısız.';
    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignMessageDuplicationSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        COUNT(*) AS total_count,
        COUNT(DISTINCT message) AS unique_message_count
      FROM campaign_recipients
      WHERE message IS NOT NULL
        AND TRIM(message)<>''
    `).get() as {
      total_count:number|null;
      unique_message_count:number|null;
    };

    const total=Number(row.total_count??0);
    const unique=Number(row.unique_message_count??0);
    const duplicated=Math.max(0,total-unique);
    const duplicationRatio=total>0?duplicated/total:0;

    console.info(
      `[Campaign Engine] Mesaj tekrar oranı: toplam=${total}, benzersiz=${unique}, tekrar=${duplicated}, oran=%${(duplicationRatio*100).toFixed(2)}.`
    );

    if(total>=20 && duplicationRatio>=0.90){
      console.warn(
        '[Campaign Engine] Kampanya alıcılarının büyük bölümünde aynı mesaj kullanılıyor.'
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Mesaj tekrar oranı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignMessageLengthIntegrity(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        COUNT(*) AS total_count,
        SUM(
          CASE
            WHEN message IS NULL OR TRIM(message)=''
            THEN 1 ELSE 0
          END
        ) AS empty_message_count,
        SUM(
          CASE
            WHEN message IS NOT NULL
             AND LENGTH(message)>1000
            THEN 1 ELSE 0
          END
        ) AS long_message_count,
        MAX(COALESCE(LENGTH(message),0)) AS max_message_length,
        AVG(COALESCE(LENGTH(message),0)) AS average_message_length
      FROM campaign_recipients
    `).get() as {
      total_count:number|null;
      empty_message_count:number|null;
      long_message_count:number|null;
      max_message_length:number|null;
      average_message_length:number|null;
    };

    const total=Number(row.total_count??0);
    const empty=Number(row.empty_message_count??0);
    const long=Number(row.long_message_count??0);
    const maxLength=Number(row.max_message_length??0);
    const averageLength=Number(row.average_message_length??0);

    console.info(
      `[Campaign Engine] Mesaj uzunluğu: toplam=${total}, boş=${empty}, 1000+ karakter=${long}, ortalama=${averageLength.toFixed(1)}, en uzun=${maxLength}.`
    );

    if(empty>0){
      console.warn(
        `[Campaign Engine] Boş kampanya mesajı bulunan alıcı kaydı tespit edildi: ${empty}.`
      );
    }

    if(long>0){
      console.warn(
        `[Campaign Engine] Çok uzun mesaj içeren alıcı kaydı tespit edildi: ${long}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Mesaj uzunluğu kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignPhoneIntegrity(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        COUNT(*) AS total_count,
        SUM(
          CASE
            WHEN phone IS NULL OR TRIM(phone)=''
            THEN 1 ELSE 0
          END
        ) AS empty_phone_count,
        SUM(
          CASE
            WHEN phone IS NOT NULL
             AND TRIM(phone)<>''
             AND LENGTH(
               REPLACE(
                 REPLACE(
                   REPLACE(
                     REPLACE(
                       REPLACE(TRIM(phone),' ',''),'-',''
                     ),'(',''),')',''
                   ),'+',''
                 )
               )<10
            THEN 1 ELSE 0
          END
        ) AS short_phone_count,
        SUM(
          CASE
            WHEN phone IS NOT NULL
             AND (
               phone GLOB '*[A-Za-z]*'
               OR phone GLOB '*[ÇĞİÖŞÜçğıöşü]*'
             )
            THEN 1 ELSE 0
          END
        ) AS alphabetic_phone_count
      FROM campaign_recipients
    `).get() as {
      total_count:number|null;
      empty_phone_count:number|null;
      short_phone_count:number|null;
      alphabetic_phone_count:number|null;
    };

    const total=Number(row.total_count??0);
    const empty=Number(row.empty_phone_count??0);
    const short=Number(row.short_phone_count??0);
    const alphabetic=Number(row.alphabetic_phone_count??0);
    const suspicious=empty+short+alphabetic;
    const suspiciousRatio=total>0?suspicious/total:0;

    console.info(
      `[Campaign Engine] Telefon bütünlüğü: toplam=${total}, boş=${empty}, kısa=${short}, harf içeren=${alphabetic}, şüpheli oran=%${(suspiciousRatio*100).toFixed(2)}.`
    );

    if(suspicious>0){
      console.warn(
        `[Campaign Engine] Geçersiz veya şüpheli telefon kaydı tespit edildi: ${suspicious}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Telefon bütünlüğü kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

