    const retryRatio=total>0?retried/total:0;

    console.info(
      `[Campaign Engine] Retry yükü: toplam=${total}, retry alan=${retried}, deneme=${attempts}, en yüksek retry=${maxRetry}, oran=%${(retryRatio*100).toFixed(2)}.`
    );

    if(total>=20 && retryRatio>=0.30){
      console.warn(
