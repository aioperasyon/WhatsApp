function reportCampaignDuplicateSettings(): void {
  const database = getDatabase();

  try {
    const duplicateCampaignCount = Number(
      database
        .prepare(
          `SELECT COUNT(*)
           FROM (
             SELECT campaign_id
             FROM campaign_settings
             GROUP BY campaign_id
             HAVING COUNT(*) > 1
           ) AS duplicate_settings`,
        )
        .pluck()
        .get() ?? 0,
    );

    const duplicateSettingsCount = Number(
      database
        .prepare(
          `SELECT COALESCE(SUM(setting_count - 1), 0)
           FROM (
             SELECT COUNT(*) AS setting_count
             FROM campaign_settings
             GROUP BY campaign_id
             HAVING COUNT(*) > 1
           ) AS duplicate_settings`,
        )
        .pluck()
        .get() ?? 0,
    );

    if (
      duplicateCampaignCount === 0 &&
      duplicateSettingsCount === 0
    ) {
      console.info(
        '[Campaign Engine] Yinelenen kampanya ayarı kontrolü başarılı.',
      );

      return;
    }

    console.warn(
      `[Campaign Engine] Yinelenen kampanya ayarı tespit edildi: etkilenen kampanya=${duplicateCampaignCount}, fazla ayar kaydı=${duplicateSettingsCount}.`,
    );
  } catch (reason: unknown) {
    const message =
      reason instanceof Error
        ? reason.message
        : 'Yinelenen kampanya ayarı kontrolü gerçekleştirilemedi.';

    console.error(
      `[Campaign Engine] Yinelenen kampanya ayarı kontrolü başarısız: ${message}`,
    );
  }
}

function reportCampaignDuplicateRecipients(): void {
  const database=getDatabase();
