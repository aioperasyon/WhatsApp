interface CampaignRow {
  id: string;
  name: string;
  account_id: string | null;
  account_name: string | null;
  message: string;
  sectors_json: string;
  cities_json: string;
  only_allowed: number;
  estimated_recipients: number;
  status: CampaignStatus;
  total_recipients: number;
  sent_count: number;
  failed_count: number;
  pending_count: number;
  started_at: string | null;
  completed_at: string | null;
  created_at: string;
  updated_at: string;
  description: string | null;
  min_delay_seconds: number | null;
  max_delay_seconds: number | null;
  batch_size: number | null;
  batch_pause_min_seconds: number | null;
  batch_pause_max_seconds: number | null;
  daily_limit: number | null;
  work_start_time: string | null;
  work_end_time: string | null;
  typing_simulation: number | null;
  retry_count: number | null;
  scheduled_at: string | null;
}

function ensureCampaignSchema(): void {
  const database = getDatabase();

  database.exec(`
    CREATE TABLE IF NOT EXISTS campaigns (
      id TEXT PRIMARY KEY,
      name TEXT NOT NULL,
      account_id TEXT,
      message TEXT NOT NULL,
      sectors_json TEXT NOT NULL DEFAULT '[]',
      cities_json TEXT NOT NULL DEFAULT '[]',
      only_allowed INTEGER NOT NULL DEFAULT 1,
      estimated_recipients INTEGER NOT NULL DEFAULT 0,
      status TEXT NOT NULL DEFAULT 'draft',
      total_recipients INTEGER NOT NULL DEFAULT 0,
      sent_count INTEGER NOT NULL DEFAULT 0,
      failed_count INTEGER NOT NULL DEFAULT 0,
      pending_count INTEGER NOT NULL DEFAULT 0,
      started_at TEXT,
      completed_at TEXT,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL
    );


    CREATE TABLE IF NOT EXISTS campaign_settings (
      campaign_id TEXT PRIMARY KEY,
      description TEXT,
      min_delay_seconds INTEGER NOT NULL DEFAULT 6,
      max_delay_seconds INTEGER NOT NULL DEFAULT 14,
      batch_size INTEGER NOT NULL DEFAULT 30,
      batch_pause_min_seconds INTEGER NOT NULL DEFAULT 45,
      batch_pause_max_seconds INTEGER NOT NULL DEFAULT 90,
      daily_limit INTEGER,
      work_start_time TEXT NOT NULL DEFAULT '09:00',
      work_end_time TEXT NOT NULL DEFAULT '18:30',
      typing_simulation INTEGER NOT NULL DEFAULT 1,
      retry_count INTEGER NOT NULL DEFAULT 2,
      scheduled_at TEXT,
      FOREIGN KEY (campaign_id) REFERENCES campaigns(id) ON DELETE CASCADE
    );

    CREATE TABLE IF NOT EXISTS campaign_recipients (
      id TEXT PRIMARY KEY,
      campaign_id TEXT NOT NULL,
      contact_id TEXT NOT NULL,
      full_name TEXT NOT NULL,
      phone_number TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'pending',
      attempt_count INTEGER NOT NULL DEFAULT 0,
      error_message TEXT,
      whatsapp_message_id TEXT,
      sent_at TEXT,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL,
      FOREIGN KEY (campaign_id) REFERENCES campaigns(id) ON DELETE CASCADE
    );

    CREATE INDEX IF NOT EXISTS idx_campaigns_updated_at
      ON campaigns(updated_at DESC);

    CREATE INDEX IF NOT EXISTS idx_campaigns_status
      ON campaigns(status);

    CREATE INDEX IF NOT EXISTS idx_campaign_recipients_campaign_status
      ON campaign_recipients(campaign_id, status);
  `);

  const campaignColumns = database
    .prepare(`PRAGMA table_info(campaigns)`)
    .all() as Array<{ name: string }>;
  const existing = new Set(campaignColumns.map((column) => column.name));

  const additions: Array<[string, string]> = [
    ['total_recipients', 'INTEGER NOT NULL DEFAULT 0'],
    ['sent_count', 'INTEGER NOT NULL DEFAULT 0'],
    ['failed_count', 'INTEGER NOT NULL DEFAULT 0'],
    ['pending_count', 'INTEGER NOT NULL DEFAULT 0'],
    ['started_at', 'TEXT'],
    ['completed_at', 'TEXT'],
  ];

  for (const [name, definition] of additions) {
    if (!existing.has(name)) {
      database.exec(
        `ALTER TABLE campaigns ADD COLUMN ${name} ${definition}`,
      );
    }
  }

  recoverInterruptedCampaigns();
}

function normalizeValues(values: string[] | undefined): string[] {
  return Array.from(
    new Set(
      (values ?? [])
        .map((value) => value.trim())
        .filter(Boolean),
    ),
  ).sort((a, b) => a.localeCompare(b, 'tr'));
}

function parseValues(value: string): string[] {
  try {
    const parsed = JSON.parse(value) as unknown;
    return Array.isArray(parsed)
      ? parsed.filter((item): item is string => typeof item === 'string')
      : [];
  } catch {
    return [];
  }
}

function mapCampaign(row: CampaignRow): Campaign {
  return {
    id: row.id,
    name: row.name,
    accountId: row.account_id,
    accountName: row.account_name,
    message: row.message,
    sectors: parseValues(row.sectors_json),
    cities: parseValues(row.cities_json),
    onlyAllowed: row.only_allowed === 1,
    estimatedRecipients: row.estimated_recipients,
    status: row.status,
    totalRecipients: row.total_recipients,
    sentCount: row.sent_count,
    failedCount: row.failed_count,
    pendingCount: row.pending_count,
    startedAt: row.started_at,
    completedAt: row.completed_at,
    createdAt: row.created_at,
    updatedAt: row.updated_at,
    settings: {
      description: row.description ?? null,
      minDelaySeconds: row.min_delay_seconds ?? 6,
      maxDelaySeconds: row.max_delay_seconds ?? 14,
      batchSize: row.batch_size ?? 30,
      batchPauseMinSeconds: row.batch_pause_min_seconds ?? 45,
      batchPauseMaxSeconds: row.batch_pause_max_seconds ?? 90,
      dailyLimit: row.daily_limit ?? null,
      workStartTime: row.work_start_time ?? '09:00',
      workEndTime: row.work_end_time ?? '18:30',
      typingSimulation: (row.typing_simulation ?? 1) === 1,
      retryCount: row.retry_count ?? 2,
      scheduledAt: row.scheduled_at ?? null,
    },
  };
}

function buildAudienceWhere(
  request: CampaignAudienceRequest,
): {
  sql: string;
  parameters: string[];
  sectors: string[];
  cities: string[];
} {
  const sectors = normalizeValues(request.sectors);
  const cities = normalizeValues(request.cities);
  const where: string[] = [];
  const parameters: string[] = [];

  if (request.onlyAllowed !== false) {
    where.push(`permission_status = 'allowed'`);
  }

  if (sectors.length > 0) {
    where.push(`sector IN (${sectors.map(() => '?').join(', ')})`);
    parameters.push(...sectors);
  }

  if (cities.length > 0) {
    where.push(`city IN (${cities.map(() => '?').join(', ')})`);
    parameters.push(...cities);
  }

  return {
    sql: where.length > 0 ? `WHERE ${where.join(' AND ')}` : '',
    parameters,
    sectors,
    cities,
  };
}

function estimateAudience(
  request: CampaignAudienceRequest = {},
): CampaignAudienceEstimate {
  const built = buildAudienceWhere(request);
  const row = getDatabase()
    .prepare(`
      SELECT COUNT(*) AS total
      FROM crm_contacts
      ${built.sql}
    `)
    .get(...built.parameters) as { total: number };

  return {
    total: Number(row.total ?? 0),
    sectors: built.sectors,
    cities: built.cities,
  };
}

function analyzeAudience(
  request: CampaignAudienceRequest & { dailyLimit?: number | null } = {},
): CampaignAudienceAnalysis {
  const database = getDatabase();
  const sectors = normalizeValues(request.sectors);
  const cities = normalizeValues(request.cities);
  const baseWhere: string[] = [];
  const baseParameters: string[] = [];

  if (sectors.length > 0) {
    baseWhere.push(`sector IN (${sectors.map(() => '?').join(', ')})`);
    baseParameters.push(...sectors);
  }

  if (cities.length > 0) {
    baseWhere.push(`city IN (${cities.map(() => '?').join(', ')})`);
    baseParameters.push(...cities);
  }

  const baseSql =
    baseWhere.length > 0
      ? `WHERE ${baseWhere.join(' AND ')}`
      : '';

  const totalCrmRow = database
    .prepare('SELECT COUNT(*) AS total FROM crm_contacts')
    .get() as { total: number };

  const filteredRow = database
    .prepare(`
      SELECT COUNT(*) AS total
      FROM crm_contacts
      ${baseSql}
    `)
    .get(...baseParameters) as { total: number };

  const allowedWhere = [...baseWhere, `permission_status = 'allowed'`];
  const allowedSql = `WHERE ${allowedWhere.join(' AND ')}`;

  const allowedRow = database
    .prepare(`
      SELECT COUNT(*) AS total
      FROM crm_contacts
      ${allowedSql}
    `)
    .get(...baseParameters) as { total: number };

  const validPhoneWhere = [
    ...allowedWhere,
    `phone_number IS NOT NULL`,
    `LENGTH(
      REPLACE(
        REPLACE(
          REPLACE(
            REPLACE(
              REPLACE(TRIM(phone_number), ' ', ''),
              '+',
              ''
            ),
            '-',
            ''
          ),
          '(',
          ''
        ),
        ')',
        ''
      )
    ) >= 10`,
  ];
  const validPhoneSql = `WHERE ${validPhoneWhere.join(' AND ')}`;

  const validPhoneRow = database
    .prepare(`
      SELECT COUNT(*) AS total
      FROM crm_contacts
      ${validPhoneSql}
    `)
    .get(...baseParameters) as { total: number };

  const totalCrm = Number(totalCrmRow.total ?? 0);
  const filtered = Number(filteredRow.total ?? 0);
  const allowed = Number(allowedRow.total ?? 0);
  const validPhone = Number(validPhoneRow.total ?? 0);
  const sendable =
    request.onlyAllowed === false
      ? filtered
      : validPhone;

  const dailyLimit =
    request.dailyLimit && request.dailyLimit > 0
      ? Math.trunc(request.dailyLimit)
      : null;
  const estimatedDays =
    dailyLimit && sendable > 0
      ? Math.max(1, Math.ceil(sendable / dailyLimit))
      : 0;
  const estimatedCompletionAt =
    estimatedDays > 0
      ? new Date(
          Date.now() + estimatedDays * 24 * 60 * 60 * 1000,
        ).toISOString()
      : null;

  return {
    totalCrm,
    filtered,
    allowed,
    validPhone,
    sendable,
    excludedByPermission: Math.max(0, filtered - allowed),
    excludedByPhone: Math.max(0, allowed - validPhone),
    estimatedDays,
    estimatedCompletionAt,
  };
}

function listCampaigns(
  request: CampaignListRequest = {},
): CampaignSnapshot {
  const search = request.search?.trim() ?? '';
  const limit = Math.min(100, Math.max(1, request.limit ?? 50));
  const offset = Math.max(0, request.offset ?? 0);
  const parameters: Array<string | number> = [];
  let where = '';

  if (search) {
    where = 'WHERE c.name LIKE ? OR c.message LIKE ?';
    parameters.push(`%${search}%`, `%${search}%`);
  }

  const totalRow = getDatabase()
    .prepare(`
      SELECT COUNT(*) AS total
      FROM campaigns c
      ${where}
    `)
    .get(...parameters) as { total: number };

  const rows = getDatabase()
    .prepare(`
      SELECT
        c.*,
        a.name AS account_name,
        s.description,
        s.min_delay_seconds,
        s.max_delay_seconds,
        s.batch_size,
        s.batch_pause_min_seconds,
        s.batch_pause_max_seconds,
        s.daily_limit,
        s.work_start_time,
        s.work_end_time,
        s.typing_simulation,
        s.retry_count,
        s.scheduled_at
      FROM campaigns c
      LEFT JOIN whatsapp_accounts a ON a.id = c.account_id
      LEFT JOIN campaign_settings s ON s.campaign_id = c.id
      ${where}
      ORDER BY c.updated_at DESC
      LIMIT ? OFFSET ?
    `)
    .all(...parameters, limit, offset) as CampaignRow[];

  return {
    campaigns: rows.map(mapCampaign),
    total: Number(totalRow.total ?? 0),
  };
}

function saveCampaign(input: CampaignSaveInput): Campaign {
  const name = input.name?.trim() ?? '';
  const message = input.message?.trim() ?? '';
  const accountId = input.accountId?.trim() || null;
  const sectors = normalizeValues(input.sectors);
  const cities = normalizeValues(input.cities);
  const onlyAllowed = input.onlyAllowed !== false;
  const status: 'draft' | 'ready' | 'scheduled' =
    input.status === 'ready' || input.status === 'scheduled'
      ? input.status
      : 'draft';

  const description = input.description?.trim() || null;
  const minDelaySeconds = Math.max(
    1,
    Math.min(3600, Math.trunc(input.minDelaySeconds ?? 6)),
  );
  const maxDelaySeconds = Math.max(
    minDelaySeconds,
    Math.min(3600, Math.trunc(input.maxDelaySeconds ?? 14)),
  );
  const batchSize = Math.max(
    0,
    Math.min(10000, Math.trunc(input.batchSize ?? 30)),
  );
  const batchPauseMinSeconds = Math.max(
    0,
    Math.min(86400, Math.trunc(input.batchPauseMinSeconds ?? 45)),
  );
  const batchPauseMaxSeconds = Math.max(
    batchPauseMinSeconds,
    Math.min(86400, Math.trunc(input.batchPauseMaxSeconds ?? 90)),
  );
  const dailyLimit =
    input.dailyLimit && input.dailyLimit > 0
      ? Math.min(100000, Math.trunc(input.dailyLimit))
      : null;
  const workStartTime = input.workStartTime || '09:00';
  const workEndTime = input.workEndTime || '18:30';
  const typingSimulation = input.typingSimulation !== false;
  const retryCount = Math.max(
    0,
    Math.min(10, Math.trunc(input.retryCount ?? 2)),
  );
  const scheduledAt = input.scheduledAt?.trim() || null;

  if (!name) throw new Error('Kampanya adı zorunludur.');
  if (!message) throw new Error('Kampanya mesajı zorunludur.');
  if (message.length > 4096) {
    throw new Error('Kampanya mesajı en fazla 4096 karakter olabilir.');
  }
  if ((status === 'ready' || status === 'scheduled') && !accountId) {
    throw new Error(
      'Hazır veya planlanmış kampanya için WhatsApp hesabı seçin.',
    );
  }
  if (status === 'scheduled' && !scheduledAt) {
    throw new Error('Planlanmış kampanya için tarih ve saat seçin.');
  }

  const id = input.id?.trim() || randomUUID();
  const existingRow = getDatabase()
    .prepare('SELECT status FROM campaigns WHERE id = ?')
    .get(id) as { status: CampaignStatus } | undefined;

  if (
    existingRow &&
    ['running', 'paused'].includes(existingRow.status)
  ) {
    throw new Error(
      'Çalışan veya duraklatılmış kampanya düzenlenemez.',
    );
  }

  const estimate = estimateAudience({
    sectors,
    cities,
    onlyAllowed,
  });
  const now = new Date().toISOString();

  if (existingRow) {
    const database = getDatabase();
    const transaction = database.transaction(() => {
      database.prepare(`
        UPDATE campaigns
        SET
          name = ?,
          account_id = ?,
          message = ?,
          sectors_json = ?,
          cities_json = ?,
          only_allowed = ?,
          estimated_recipients = ?,
          status = ?,
          total_recipients = 0,
          sent_count = 0,
          failed_count = 0,
          pending_count = 0,
          started_at = NULL,
          completed_at = NULL,
          updated_at = ?
        WHERE id = ?
      `).run(
        name,
        accountId,
        message,
        JSON.stringify(sectors),
        JSON.stringify(cities),
        onlyAllowed ? 1 : 0,
        estimate.total,
        status,
        now,
        id,
      );


      database.prepare(`
        INSERT INTO campaign_settings (
          campaign_id,
          description,
          min_delay_seconds,
          max_delay_seconds,
          batch_size,
          batch_pause_min_seconds,
          batch_pause_max_seconds,
          daily_limit,
          work_start_time,
          work_end_time,
          typing_simulation,
          retry_count,
          scheduled_at
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ON CONFLICT(campaign_id) DO UPDATE SET
          description = excluded.description,
          min_delay_seconds = excluded.min_delay_seconds,
          max_delay_seconds = excluded.max_delay_seconds,
          batch_size = excluded.batch_size,
          batch_pause_min_seconds = excluded.batch_pause_min_seconds,
          batch_pause_max_seconds = excluded.batch_pause_max_seconds,
          daily_limit = excluded.daily_limit,
          work_start_time = excluded.work_start_time,
          work_end_time = excluded.work_end_time,
          typing_simulation = excluded.typing_simulation,
          retry_count = excluded.retry_count,
          scheduled_at = excluded.scheduled_at
      `).run(
        id,
        description,
        minDelaySeconds,
        maxDelaySeconds,
        batchSize,
        batchPauseMinSeconds,
        batchPauseMaxSeconds,
        dailyLimit,
        workStartTime,
        workEndTime,
        typingSimulation ? 1 : 0,
        retryCount,
        scheduledAt,
      );

      database.prepare(`
        DELETE FROM campaign_recipients WHERE campaign_id = ?
      `).run(id);
    });
    transaction();
  } else {
    getDatabase().prepare(`
      INSERT INTO campaigns (
        id, name, account_id, message, sectors_json, cities_json,
        only_allowed, estimated_recipients, status,
        total_recipients, sent_count, failed_count, pending_count,
        started_at, completed_at, created_at, updated_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0, 0, 0, 0, NULL, NULL, ?, ?)
    `).run(
      id,
      name,
      accountId,
      message,
      JSON.stringify(sectors),
      JSON.stringify(cities),
      onlyAllowed ? 1 : 0,
      estimate.total,
      status,
      now,
      now,
    );

    getDatabase().prepare(`
      INSERT INTO campaign_settings (
        campaign_id,
        description,
        min_delay_seconds,
        max_delay_seconds,
        batch_size,
        batch_pause_min_seconds,
        batch_pause_max_seconds,
        daily_limit,
        work_start_time,
        work_end_time,
        typing_simulation,
        retry_count,
        scheduled_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      id,
      description,
      minDelaySeconds,
      maxDelaySeconds,
      batchSize,
      batchPauseMinSeconds,
      batchPauseMaxSeconds,
      dailyLimit,
      workStartTime,
      workEndTime,
      typingSimulation ? 1 : 0,
      retryCount,
      scheduledAt,
    );
  }

  return listCampaigns({ limit: 100 }).campaigns.find(
    (campaign) => campaign.id === id,
  ) as Campaign;
}

function deleteCampaign(
  request: CampaignDeleteRequest,
): CampaignDeleteResult {
  const campaign = listCampaigns({ limit: 100 }).campaigns.find(
    (item) => item.id === request.id,
  );

  if (campaign && ['running', 'paused'].includes(campaign.status)) {
    throw new Error(
      'Çalışan veya duraklatılmış kampanya silinemez.',
    );
  }

  const result = getDatabase()
    .prepare('DELETE FROM campaigns WHERE id = ?')
    .run(request.id);

  return { deleted: result.changes > 0 };
}

function getAudienceOptions(): {
  sectors: string[];
  cities: string[];
} {
  const database = getDatabase();
  const sectors = database
    .prepare(`
      SELECT DISTINCT sector AS value
      FROM crm_contacts
      WHERE sector IS NOT NULL AND TRIM(sector) <> ''
      ORDER BY sector COLLATE NOCASE
    `)
    .all() as Array<{ value: string }>;
  const cities = database
    .prepare(`
      SELECT DISTINCT city AS value
      FROM crm_contacts
      WHERE city IS NOT NULL AND TRIM(city) <> ''
      ORDER BY city COLLATE NOCASE
    `)
    .all() as Array<{ value: string }>;

  return {
    sectors: sectors.map((row) => row.value),
    cities: cities.map((row) => row.value),
  };
}

function ensureCampaignPerformanceIndexes(): void {
  const database = getDatabase();

  database.exec(`
    CREATE INDEX IF NOT EXISTS idx_campaigns_status_updated
      ON campaigns(status, updated_at);

    CREATE INDEX IF NOT EXISTS idx_campaign_recipients_campaign_status
      ON campaign_recipients(campaign_id, status);

    CREATE INDEX IF NOT EXISTS idx_campaign_recipients_status_updated
      ON campaign_recipients(status, updated_at);

    CREATE INDEX IF NOT EXISTS idx_campaign_recipients_phone
      ON campaign_recipients(phone_number);

    CREATE INDEX IF NOT EXISTS idx_campaign_settings_scheduled_at
      ON campaign_settings(scheduled_at);

    CREATE INDEX IF NOT EXISTS idx_campaign_settings_campaign
      ON campaign_settings(campaign_id);
  

    CREATE INDEX IF NOT EXISTS idx_campaign_recipients_active_queue
      ON campaign_recipients (campaign_id, id)
      WHERE status IN ('pending', 'sending');

    CREATE INDEX IF NOT EXISTS idx_campaigns_active_status
      ON campaigns (status, updated_at)
      WHERE status IN ('running', 'paused', 'scheduled');
`);
}

function reportCampaignRecentStatusChangesSnapshot(): void {
  const database = getDatabase();

  try {
    const row = database
      .prepare(
        `SELECT
           SUM(
             CASE
               WHEN updated_at >= datetime('now', '-15 minutes')
               THEN 1
               ELSE 0
             END
           ) AS changed_last_15_minutes,
           SUM(
             CASE
               WHEN updated_at >= datetime('now', '-1 hour')
               THEN 1
               ELSE 0
             END
           ) AS changed_last_hour,
           SUM(
             CASE
               WHEN updated_at >= datetime('now', '-24 hours')
               THEN 1
               ELSE 0
             END
           ) AS changed_last_day
         FROM campaign_recipients`,
      )
      .get() as {
        changed_last_15_minutes: number | null;
        changed_last_hour: number | null;
        changed_last_day: number | null;
      };

    const last15Minutes = Number(
      row.changed_last_15_minutes ?? 0,
    );
    const lastHour = Number(
      row.changed_last_hour ?? 0,
    );
    const lastDay = Number(
      row.changed_last_day ?? 0,
    );

    console.info(
      `[Campaign Engine] Son durum hareketleri: 15dk=${last15Minutes}, 1sa=${lastHour}, 24sa=${lastDay}.`,
    );

    if (
      lastDay > 0 &&
      lastHour === 0
    ) {
      console.warn(
        '[Campaign Engine] Son 24 saatte hareket var ancak son bir saatte durum değişikliği yok.',
      );
    }
  } catch (reason: unknown) {
    const message =
      reason instanceof Error
        ? reason.message
        : 'Son durum hareketleri raporu oluşturulamadı.';

    console.error(
      `[Campaign Engine] Son durum hareketleri raporu başarısız: ${message}`,
    );
  }
}

function reportCampaignStatusDistributionSnapshot(): void {
  const database = getDatabase();

  try {
    const rows = database
      .prepare(
        `SELECT
           status,
           COUNT(*) AS total
         FROM campaign_recipients
         GROUP BY status
         ORDER BY total DESC, status ASC`,
      )
      .all() as Array<{
        status: string | null;
        total: number;
      }>;

    if (rows.length === 0) {
      console.info(
        '[Campaign Engine] Durum dağılımı özeti: kayıt bulunamadı.',
      );

      return;
    }

    const summary = rows
      .map(
        (row) =>
          `${row.status ?? 'NULL'}=${Number(row.total)}`,
      )
      .join(', ');

    console.info(
      `[Campaign Engine] Durum dağılımı özeti: ${summary}.`,
    );
  } catch (reason: unknown) {
    const message =
      reason instanceof Error
        ? reason.message
        : 'Durum dağılımı raporu oluşturulamadı.';

    console.error(
      `[Campaign Engine] Durum dağılımı raporu başarısız: ${message}`,
    );
  }
}

function reportCampaignStatusTransitionSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(
          CASE
            WHEN status='sending'
            THEN 1 ELSE 0
          END
        ) AS sending_count,
        SUM(
          CASE
            WHEN status='sending'
             AND COALESCE(updated_at,created_at)<datetime('now','-30 minutes')
            THEN 1 ELSE 0
          END
        ) AS stale_sending_count,
        SUM(
          CASE
            WHEN status='pending'
            THEN 1 ELSE 0
          END
        ) AS pending_count,
        SUM(
          CASE
            WHEN status IN ('sent','delivered','read')
            THEN 1 ELSE 0
          END
        ) AS completed_count
      FROM campaign_recipients
    `).get() as {
      sending_count:number|null;
      stale_sending_count:number|null;
      pending_count:number|null;
      completed_count:number|null;
    };

    const sending=Number(row.sending_count??0);
    const staleSending=Number(row.stale_sending_count??0);
    const pending=Number(row.pending_count??0);
    const completed=Number(row.completed_count??0);
    const staleRatio=sending>0?staleSending/sending:0;

    console.info(
      `[Campaign Engine] Durum geçiş özeti: pending=${pending}, sending=${sending}, 30dk+ sending=${staleSending}, completed=${completed}, takılı sending oranı=%${(staleRatio*100).toFixed(2)}.`
    );

    if(staleSending>0){
      console.warn(
        `[Campaign Engine] Sending durumunda 30 dakikadan uzun kalan kayıtlar tespit edildi: ${staleSending}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Durum geçiş kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignPeakHourSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        strftime('%H',COALESCE(updated_at,created_at)) AS hour_bucket,
        COUNT(*) AS processed_count
      FROM campaign_recipients
      WHERE status IN ('sent','delivered','read','failed')
        AND COALESCE(updated_at,created_at)>=datetime('now','-7 days')
      GROUP BY strftime('%H',COALESCE(updated_at,created_at))
      ORDER BY processed_count DESC
      LIMIT 1
    `).get() as {
      hour_bucket:string|null;
      processed_count:number|null;
    } | undefined;

    const hour=row?.hour_bucket??null;
    const processed=Number(row?.processed_count??0);

    console.info(
      hour
        ?`[Campaign Engine] Son 7 günün en yoğun işlem saati: ${hour}:00, işlenen=${processed}.`
        :'[Campaign Engine] Son 7 gün için yoğun saat verisi bulunamadı.'
    );

    if(processed>=1000){
      console.warn(
        '[Campaign Engine] Tek saat diliminde çok yüksek kampanya işlem hacmi tespit edildi.'
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Yoğun saat analizi başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignAccountUtilizationSnapshot(): void {
 const db=getDatabase();
 try{
  const row=db.prepare(`SELECT COUNT(DISTINCT account_id) AS account_count, COUNT(*) AS active_count FROM campaign_recipients WHERE status IN ('pending','sending') AND account_id IS NOT NULL AND TRIM(account_id)<>''`).get() as {
   account_count:number|null;
   active_count:number|null;
  };
  const accounts=Number(row.account_count??0);
  const active=Number(row.active_count??0);
  const avg=accounts>0?active/accounts:0;
  console.info(`[Campaign Engine] Hesap kullanım özeti: aktif hesap=${accounts}, aktif alıcı=${active}, hesap başına ortalama=${avg.toFixed(2)}.`);
  if(accounts>0&&avg>500) console.warn('[Campaign Engine] Hesap başına aktif yük oldukça yüksek görünüyor.');
 }catch(reason){
  const message=reason instanceof Error?reason.message:'Hesap kullanım özeti başarısız.';
  console.error(`[Campaign Engine] ${message}`);
 }
}
function reportCampaignUnassignedAccountSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(
          CASE
            WHEN account_id IS NULL OR TRIM(account_id)=''
            THEN 1 ELSE 0
          END
        ) AS unassigned_total,
        SUM(
          CASE
            WHEN (account_id IS NULL OR TRIM(account_id)='')
             AND status IN ('pending','sending')
            THEN 1 ELSE 0
          END
        ) AS unassigned_active,
        SUM(
          CASE
            WHEN status IN ('pending','sending')
            THEN 1 ELSE 0
          END
        ) AS active_total,
        COUNT(*) AS recipient_total
      FROM campaign_recipients
    `).get() as {
      unassigned_total:number|null;
      unassigned_active:number|null;
      active_total:number|null;
      recipient_total:number|null;
    };

    const unassignedTotal=Number(row.unassigned_total??0);
    const unassignedActive=Number(row.unassigned_active??0);
    const activeTotal=Number(row.active_total??0);
    const recipientTotal=Number(row.recipient_total??0);
    const activeRatio=activeTotal>0?unassignedActive/activeTotal:0;

    console.info(
      `[Campaign Engine] Hesap atama özeti: atanmamış toplam=${unassignedTotal}, atanmamış aktif=${unassignedActive}, aktif toplam=${activeTotal}, tüm alıcılar=${recipientTotal}, aktif atanmamış oranı=%${(activeRatio*100).toFixed(2)}.`
    );

    if(unassignedActive>0){
      console.warn(
        `[Campaign Engine] Gönderim hesabı atanmamış aktif alıcı kayıtları tespit edildi: ${unassignedActive}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Hesap atama kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignAccountLoadDistribution(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        COUNT(*) AS account_count,
        COALESCE(MAX(recipient_count),0) AS highest_load,
        COALESCE(MIN(recipient_count),0) AS lowest_load,
        COALESCE(AVG(recipient_count),0) AS average_load
      FROM (
        SELECT
          account_id,
          COUNT(*) AS recipient_count
        FROM campaign_recipients
        WHERE account_id IS NOT NULL
          AND TRIM(account_id)<>''
          AND status IN ('pending','sending')
        GROUP BY account_id
      )
    `).get() as {
      account_count:number|null;
      highest_load:number|null;
      lowest_load:number|null;
      average_load:number|null;
    };

    const accounts=Number(row.account_count??0);
    const highest=Number(row.highest_load??0);
    const lowest=Number(row.lowest_load??0);
    const average=Number(row.average_load??0);
    const imbalance=lowest>0?highest/lowest:highest;

    console.info(
      `[Campaign Engine] Hesap yük dağılımı: hesap=${accounts}, en yüksek=${highest}, en düşük=${lowest}, ortalama=${average.toFixed(2)}, dengesizlik=${imbalance.toFixed(2)}x.`
    );

    if(accounts>=2 && highest>=20 && imbalance>=3){
      console.warn(
        '[Campaign Engine] Aktif kampanya yükü WhatsApp hesapları arasında dengesiz dağılıyor.'
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Hesap yük dağılımı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignSizeDistributionSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(CASE WHEN recipient_count BETWEEN 1 AND 10 THEN 1 ELSE 0 END) AS size_1_10,
        SUM(CASE WHEN recipient_count BETWEEN 11 AND 100 THEN 1 ELSE 0 END) AS size_11_100,
        SUM(CASE WHEN recipient_count BETWEEN 101 AND 1000 THEN 1 ELSE 0 END) AS size_101_1000,
        SUM(CASE WHEN recipient_count>1000 THEN 1 ELSE 0 END) AS size_over_1000,
        COALESCE(MAX(recipient_count),0) AS largest_campaign,
        COUNT(*) AS campaign_count
      FROM (
        SELECT
          campaign_id,
          COUNT(*) AS recipient_count
        FROM campaign_recipients
        GROUP BY campaign_id
      )
    `).get() as {
      size_1_10:number|null;
      size_11_100:number|null;
      size_101_1000:number|null;
      size_over_1000:number|null;
      largest_campaign:number|null;
      campaign_count:number|null;
    };

    const small=Number(row.size_1_10??0);
    const medium=Number(row.size_11_100??0);
    const large=Number(row.size_101_1000??0);
    const veryLarge=Number(row.size_over_1000??0);
    const largest=Number(row.largest_campaign??0);
    const campaigns=Number(row.campaign_count??0);

    console.info(
      `[Campaign Engine] Kampanya büyüklük dağılımı: 1-10=${small}, 11-100=${medium}, 101-1000=${large}, 1000+=${veryLarge}, kampanya=${campaigns}, en büyük=${largest}.`
    );

    if(veryLarge>0){
      console.warn(
        `[Campaign Engine] Bin alıcıdan büyük kampanya sayısı: ${veryLarge}. Gönderim kapasitesi ve gecikmeler izlenmeli.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Kampanya büyüklük dağılımı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignDuplicateRecipientSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        COUNT(*) AS duplicate_group_count,
        COALESCE(SUM(recipient_count-1),0) AS duplicate_record_count,
        COALESCE(MAX(recipient_count),0) AS max_duplicate_count
      FROM (
        SELECT
          campaign_id,
          phone,
          COUNT(*) AS recipient_count
        FROM campaign_recipients
        WHERE phone IS NOT NULL
          AND TRIM(phone)<>''
        GROUP BY campaign_id,phone
        HAVING COUNT(*)>1
      )
    `).get() as {
      duplicate_group_count:number|null;
      duplicate_record_count:number|null;
      max_duplicate_count:number|null;
    };

    const groups=Number(row.duplicate_group_count??0);
    const records=Number(row.duplicate_record_count??0);
    const maximum=Number(row.max_duplicate_count??0);

    console.info(
      `[Campaign Engine] Mükerrer alıcı özeti: grup=${groups}, fazla kayıt=${records}, tek numaradaki en yüksek tekrar=${maximum}.`
    );

    if(records>0){
      console.warn(
        `[Campaign Engine] Aynı kampanya içinde mükerrer telefon kayıtları tespit edildi: ${records} fazla kayıt.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Mükerrer alıcı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignCancellationSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(
          CASE
            WHEN status='cancelled'
            THEN 1 ELSE 0
          END
        ) AS cancelled_count,
        SUM(
          CASE
            WHEN status='cancelled'
             AND COALESCE(updated_at,created_at)>=datetime('now','-24 hours')
            THEN 1 ELSE 0
          END
        ) AS cancelled_last_day,
        SUM(
          CASE
            WHEN status IN ('sent','delivered','read','failed','cancelled')
            THEN 1 ELSE 0
          END
        ) AS terminal_count,
        COUNT(*) AS total_count
      FROM campaign_recipients
    `).get() as {
      cancelled_count:number|null;
      cancelled_last_day:number|null;
      terminal_count:number|null;
      total_count:number|null;
    };

    const cancelled=Number(row.cancelled_count??0);
    const cancelledLastDay=Number(row.cancelled_last_day??0);
    const terminal=Number(row.terminal_count??0);
    const total=Number(row.total_count??0);
    const cancellationRatio=terminal>0?cancelled/terminal:0;

    console.info(
      `[Campaign Engine] İptal özeti: toplam iptal=${cancelled}, son 24 saat=${cancelledLastDay}, terminal=${terminal}, tüm kayıtlar=${total}, iptal oranı=%${(cancellationRatio*100).toFixed(2)}.`
    );

    if(terminal>=25 && cancellationRatio>=0.20){
      console.warn(
        '[Campaign Engine] Kampanya iptal oranı yüksek görünüyor.'
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Kampanya iptal özeti kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignFailureAgeBuckets(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(
          CASE
            WHEN status='failed'
             AND COALESCE(updated_at,created_at)>=datetime('now','-1 hour')
            THEN 1 ELSE 0
          END
        ) AS failed_last_hour,
        SUM(
          CASE
            WHEN status='failed'
             AND COALESCE(updated_at,created_at)<datetime('now','-1 hour')
             AND COALESCE(updated_at,created_at)>=datetime('now','-1 day')
            THEN 1 ELSE 0
          END
        ) AS failed_1_24_hours,
        SUM(
          CASE
            WHEN status='failed'
             AND COALESCE(updated_at,created_at)<datetime('now','-1 day')
             AND COALESCE(updated_at,created_at)>=datetime('now','-7 days')
            THEN 1 ELSE 0
          END
        ) AS failed_1_7_days,
        SUM(
          CASE
            WHEN status='failed'
             AND COALESCE(updated_at,created_at)<datetime('now','-7 days')
            THEN 1 ELSE 0
          END
        ) AS failed_over_7_days
      FROM campaign_recipients
    `).get() as {
      failed_last_hour:number|null;
      failed_1_24_hours:number|null;
      failed_1_7_days:number|null;
      failed_over_7_days:number|null;
    };

    const recent=Number(row.failed_last_hour??0);
    const daily=Number(row.failed_1_24_hours??0);
    const weekly=Number(row.failed_1_7_days??0);
    const old=Number(row.failed_over_7_days??0);
    const total=recent+daily+weekly+old;

    console.info(
      `[Campaign Engine] Başarısız kayıt yaş dağılımı: 0-1sa=${recent}, 1-24sa=${daily}, 1-7gün=${weekly}, 7gün+=${old}, toplam=${total}.`
    );

    if(old>=10){
      console.warn(
        `[Campaign Engine] Yedi günden uzun süredir başarısız durumda kalan kayıt sayısı yüksek: ${old}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Başarısız kayıt yaş dağılımı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignMonthlyActivitySnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(
          CASE
            WHEN created_at>=datetime('now','-30 days')
            THEN 1 ELSE 0
          END
        ) AS created_last_month,
        SUM(
          CASE
            WHEN status IN ('sent','delivered','read')
             AND updated_at>=datetime('now','-30 days')
            THEN 1 ELSE 0
          END
        ) AS completed_last_month,
        SUM(
          CASE
            WHEN status='failed'
             AND updated_at>=datetime('now','-30 days')
            THEN 1 ELSE 0
          END
        ) AS failed_last_month,
        SUM(
          CASE
            WHEN status IN ('pending','sending')
            THEN 1 ELSE 0
          END
        ) AS active_count
      FROM campaign_recipients
    `).get() as {
      created_last_month:number|null;
      completed_last_month:number|null;
      failed_last_month:number|null;
      active_count:number|null;
    };

    const created=Number(row.created_last_month??0);
    const completed=Number(row.completed_last_month??0);
    const failed=Number(row.failed_last_month??0);
    const active=Number(row.active_count??0);
    const processed=completed+failed;
    const successRatio=processed>0?completed/processed:0;

    console.info(
      `[Campaign Engine] Aylık aktivite: yeni=${created}, başarılı=${completed}, başarısız=${failed}, aktif=${active}, başarı oranı=%${(successRatio*100).toFixed(2)}.`
    );

    if(processed>=100 && successRatio<0.75){
      console.warn(
        '[Campaign Engine] Son 30 günlük kampanya başarı oranı beklenen seviyenin altında.'
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Aylık aktivite kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

