}

function reportCampaignQueueDrainEstimate(): void {
  const db=getDatabase();
  try{
    const row=db.prepare(`
      SELECT
        SUM(CASE WHEN status IN ('pending','sending') THEN 1 ELSE 0 END) active_count,
        SUM(CASE WHEN status IN ('sent','delivered','read') AND updated_at>=datetime('now','-1 hour') THEN 1 ELSE 0 END) completed_last_hour
      FROM campaign_recipients
    `).get() as {active_count:number|null;completed_last_hour:number|null;};
    const active=Number(row.active_count??0);
    const throughput=Number(row.completed_last_hour??0);
    const eta=throughput>0?(active/throughput).toFixed(1):'∞';
    console.info(`[Campaign Engine] Kuyruk tahmini: aktif=${active}, saatlik=${throughput}, ETA=${eta} saat.`);
    if(active>100&&throughput===0){
      console.warn('[Campaign Engine] Büyük kuyruk olmasına rağmen son saatte ilerleme yok.');
    }
  }catch(e){
    console.error(`[Campaign Engine] ${e instanceof Error?e.message:'Kuyruk tahmini başarısız.'}`);
  }
}

function reportCampaignThroughputSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(
          CASE
            WHEN status IN ('sent','delivered','read')
             AND updated_at>=datetime('now','-1 hour')
            THEN 1 ELSE 0
          END
        ) AS completed_last_hour,
        SUM(
          CASE
            WHEN status='failed'
             AND updated_at>=datetime('now','-1 hour')
            THEN 1 ELSE 0
          END
        ) AS failed_last_hour,
        SUM(
          CASE
            WHEN status IN ('pending','sending')
            THEN 1 ELSE 0
          END
        ) AS active_count
      FROM campaign_recipients
    `).get() as {
      completed_last_hour:number|null;
      failed_last_hour:number|null;
      active_count:number|null;
    };

    const completed=Number(row.completed_last_hour??0);
    const failed=Number(row.failed_last_hour??0);
    const active=Number(row.active_count??0);
    const processed=completed+failed;

    console.info(
      `[Campaign Engine] Saatlik iş hacmi: işlenen=${processed}, başarılı=${completed}, başarısız=${failed}, aktif=${active}.`
    );

    if(active>=20 && processed===0){
      console.warn(
        '[Campaign Engine] Aktif kuyruk bulunmasına rağmen son bir saatte işlem tamamlanmadı.'
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Saatlik iş hacmi kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

