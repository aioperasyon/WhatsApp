    const row=database.prepare(`
      SELECT COUNT(*) FROM (
        SELECT campaign_id, phone
        FROM campaign_recipients
        WHERE phone IS NOT NULL AND TRIM(phone)<>''
        GROUP BY campaign_id, phone
        HAVING COUNT(*)>1
      )
    `).pluck().get();

