function reportCampaignCompletionConsistency(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(CASE WHEN status IN ('sent','delivered','read') THEN 1 ELSE 0 END) AS completed,
        SUM(CASE WHEN status IN ('pending','sending') THEN 1 ELSE 0 END) AS active,
        SUM(CASE WHEN status='failed' THEN 1 ELSE 0 END) AS failed,
        COUNT(*) AS total
      FROM campaign_recipients
    `).get() as {
      completed:number|null;
      active:number|null;
      failed:number|null;
      total:number|null;
    };

    const completed=Number(row.completed??0);
    const active=Number(row.active??0);
    const failed=Number(row.failed??0);
    const total=Number(row.total??0);

    const accounted=completed+active+failed;
    const unknown=Math.max(0,total-accounted);

    console.info(
      `[Campaign Engine] Tamamlanma tutarlılığı: toplam=${total}, tamamlanan=${completed}, aktif=${active}, başarısız=${failed}, bilinmeyen=${unknown}.`
    );

    if(unknown>0){
      console.warn(
        `[Campaign Engine] Beklenmeyen durumdaki alıcı kaydı tespit edildi: ${unknown}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error?reason.message:'Tamamlanma tutarlılığı kontrolü başarısız.';
    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignBatchHealthSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        COUNT(DISTINCT campaign_id) AS campaign_count,
        SUM(CASE WHEN status='pending' THEN 1 ELSE 0 END) AS pending_count,
        SUM(CASE WHEN status='sending' THEN 1 ELSE 0 END) AS sending_count,
        SUM(CASE WHEN status IN ('sent','delivered','read') THEN 1 ELSE 0 END) AS completed_count,
        SUM(CASE WHEN status='failed' THEN 1 ELSE 0 END) AS failed_count
      FROM campaign_recipients
    `).get() as {
      campaign_count:number|null;
      pending_count:number|null;
      sending_count:number|null;
      completed_count:number|null;
      failed_count:number|null;
    };

    const campaigns=Number(row.campaign_count??0);
    const pending=Number(row.pending_count??0);
    const sending=Number(row.sending_count??0);
    const completed=Number(row.completed_count??0);
    const failed=Number(row.failed_count??0);

    console.info(
      `[Campaign Engine] Batch snapshot: kampanya=${campaigns}, pending=${pending}, sending=${sending}, tamamlanan=${completed}, failed=${failed}.`
    );

    if(failed>completed && failed>=10){
      console.warn('[Campaign Engine] Başarısız gönderimler başarılı gönderimlerden fazla.');
    }
  }catch(reason){
    const message=reason instanceof Error?reason.message:'Batch snapshot başarısız.';
    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignRetryConfigurationIntegrity(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(CASE WHEN retry_count IS NULL THEN 1 ELSE 0 END) AS missing_retry,
        SUM(CASE WHEN retry_count<0 THEN 1 ELSE 0 END) AS negative_retry,
        SUM(CASE WHEN retry_count>20 THEN 1 ELSE 0 END) AS excessive_retry
      FROM campaign_settings
    `).get() as {
      missing_retry:number|null;
      negative_retry:number|null;
      excessive_retry:number|null;
    };

    const missing=Number(row.missing_retry??0);
    const negative=Number(row.negative_retry??0);
    const excessive=Number(row.excessive_retry??0);

    if(missing===0 && negative===0 && excessive===0){
      console.info('[Campaign Engine] Retry yapılandırması kontrolü başarılı.');
      return;
    }

    console.warn(
      `[Campaign Engine] Retry yapılandırması anomalisi: eksik=${missing}, negatif=${negative}, yüksek=${excessive}.`
    );
  }catch(reason){
    const message=reason instanceof Error?reason.message:'Retry yapılandırması kontrolü başarısız.';
    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignRetryExhaustionSnapshot(): void {
  const database = getDatabase();

  try {
    const row = database
      .prepare(
        `SELECT
           SUM(
             CASE
               WHEN recipient.status = 'failed'
                AND COALESCE(recipient.retry_count, 0) >=
                  COALESCE(settings.retry_count, 0)
               THEN 1
               ELSE 0
             END
           ) AS exhausted,
           SUM(
             CASE
               WHEN recipient.status = 'failed'
               THEN 1
               ELSE 0
             END
           ) AS total_failed
         FROM campaign_recipients AS recipient
         LEFT JOIN campaign_settings AS settings
           ON settings.campaign_id = recipient.campaign_id`,
      )
      .get() as {
        exhausted: number | null;
        total_failed: number | null;
      };

    const exhausted = Number(
      row.exhausted ?? 0,
    );
    const totalFailed = Number(
      row.total_failed ?? 0,
    );

    const exhaustionRate =
      totalFailed > 0
        ? Number(
            ((exhausted / totalFailed) * 100).toFixed(2),
          )
        : 0;

    console.info(
      `[Campaign Engine] Retry tükenme snapshot: retry hakkı biten=${exhausted}, toplam başarısız=${totalFailed}, oran=%${exhaustionRate.toFixed(2)}.`,
    );

    if (
      exhausted >= 20 ||
      exhaustionRate >= 50
    ) {
      console.warn(
        `[Campaign Engine] Yüksek retry tükenme seviyesi tespit edildi: kayıt=${exhausted}, oran=%${exhaustionRate.toFixed(2)}.`,
      );
    }
  } catch (reason: unknown) {
    const message =
      reason instanceof Error
        ? reason.message
        : 'Retry tükenme raporu oluşturulamadı.';

    console.error(
      `[Campaign Engine] Retry tükenme raporu başarısız: ${message}`,
    );
  }
}

function reportCampaignPendingAgeSnapshot(): void {
  const db=getDatabase();
  try{
    const row=db.prepare(`
      SELECT
        SUM(CASE
          WHEN status='pending'
           AND updated_at IS NOT NULL
           AND datetime(updated_at)<datetime('now','-1 hour')
          THEN 1 ELSE 0 END) AS stale_pending,
        SUM(CASE WHEN status='pending' THEN 1 ELSE 0 END) AS total_pending
      FROM campaign_recipients
    `).get() as {
      stale_pending:number|null;
      total_pending:number|null;
    };

    const stale=Number(row.stale_pending??0);
    const total=Number(row.total_pending??0);
    const ratio=total>0?Number(((stale/total)*100).toFixed(2)):0;

    console.info(
      `[Campaign Engine] Pending yaş analizi: eski pending=${stale}, toplam pending=${total}, oran=%${ratio.toFixed(2)}.`
    );

    if(stale>0){
      console.warn(
        `[Campaign Engine] 1 saatten eski pending kayıt bulundu: ${stale}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error?reason.message:'Pending yaş analizi başarısız.';
    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignStaleSendingRecipients(): void {
  const database = getDatabase();

  try {
    const row = database
      .prepare(
        `SELECT
           SUM(
             CASE
               WHEN status = 'sending'
                AND updated_at IS NOT NULL
                AND datetime(updated_at) < datetime('now', '-15 minutes')
               THEN 1
               ELSE 0
             END
           ) AS stale_sending,
           SUM(
             CASE
               WHEN status = 'sending'
               THEN 1
               ELSE 0
             END
           ) AS total_sending
         FROM campaign_recipients`,
      )
      .get() as {
        stale_sending: number | null;
        total_sending: number | null;
      };

    const staleSending = Number(
      row.stale_sending ?? 0,
    );
    const totalSending = Number(
      row.total_sending ?? 0,
    );

    const staleRatio =
      totalSending > 0
        ? Number(
            ((staleSending / totalSending) * 100).toFixed(2),
          )
        : 0;

    console.info(
      `[Campaign Engine] Beklemede kalan gönderim snapshot: 15 dakikadan eski=${staleSending}, toplam gönderiliyor=${totalSending}, oran=%${staleRatio.toFixed(2)}.`,
    );

    if (staleSending > 0) {
      console.warn(
        `[Campaign Engine] Uzun süredir "sending" durumunda kalan alıcılar tespit edildi: ${staleSending}.`,
      );
    }
  } catch (reason: unknown) {
    const message =
      reason instanceof Error
        ? reason.message
        : 'Beklemede kalan gönderim kontrolü gerçekleştirilemedi.';

    console.error(
      `[Campaign Engine] Beklemede kalan gönderim kontrolü başarısız: ${message}`,
    );
  }
}

