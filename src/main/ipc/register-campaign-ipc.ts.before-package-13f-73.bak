    const sending=Number(row.sending??0);
    const failed=Number(row.failed??0);
    const completed=Number(row.completed??0);

    const inflight=pending+sending;

    console.info(
      `[Campaign Engine] İşlem dengesi: bekleyen=${pending}, gönderiliyor=${sending}, aktif=${inflight}, tamamlanan=${completed}, başarısız=${failed}.`
    );

    if(inflight>0 && completed===0 && failed===0){
      console.warn('[Campaign Engine] İşlem kuyruğu ilerlemiyor görünüyor.');
    }
