function reportCampaignOldestActiveRecipient(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        campaign_id,
        status,
        created_at,
        updated_at
      FROM campaign_recipients
      WHERE status IN ('pending','sending')
      ORDER BY COALESCE(updated_at,created_at) ASC
      LIMIT 1
    `).get() as {
      campaign_id:string|number|null;
      status:string|null;
      created_at:string|null;
      updated_at:string|null;
    } | undefined;

    if(!row){
      console.info('[Campaign Engine] Aktif alıcı yaşı: bekleyen veya gönderiliyor durumunda kayıt yok.');
      return;
    }

    const campaignId=String(row.campaign_id??'bilinmiyor');
    const status=String(row.status??'bilinmiyor');
    const timestamp=row.updated_at??row.created_at;

    if(!timestamp){
      console.warn(
        `[Campaign Engine] Aktif alıcı zaman bilgisi eksik: kampanya=${campaignId}, durum=${status}.`
      );
      return;
    }

    const parsedAt=new Date(timestamp).getTime();

    if(Number.isNaN(parsedAt)){
      console.warn(
        `[Campaign Engine] Aktif alıcı zaman bilgisi geçersiz: kampanya=${campaignId}, değer=${timestamp}.`
      );
      return;
    }

    const ageMinutes=Math.max(0,Math.floor((Date.now()-parsedAt)/60000));

    console.info(
      `[Campaign Engine] En eski aktif alıcı: kampanya=${campaignId}, durum=${status}, yaş=${ageMinutes} dakika.`
    );

    if(ageMinutes>=60){
      console.warn(
        `[Campaign Engine] Uzun süredir aktif durumda kalan alıcı tespit edildi: ${ageMinutes} dakika.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Aktif alıcı yaşı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignCompletionRatioSnapshot(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        COUNT(*) AS total_count,
        SUM(CASE WHEN status IN ('sent','delivered','read') THEN 1 ELSE 0 END) AS completed_count,
        SUM(CASE WHEN status='failed' THEN 1 ELSE 0 END) AS failed_count,
        SUM(CASE WHEN status IN ('pending','sending') THEN 1 ELSE 0 END) AS active_count
      FROM campaign_recipients
    `).get() as {
      total_count:number|null;
      completed_count:number|null;
      failed_count:number|null;
      active_count:number|null;
    };

    const total=Number(row.total_count??0);
    const completed=Number(row.completed_count??0);
    const failed=Number(row.failed_count??0);
    const active=Number(row.active_count??0);

    const completionRatio=total>0?completed/total:0;
    const failureRatio=total>0?failed/total:0;

    console.info(
      `[Campaign Engine] Tamamlanma oranı: toplam=${total}, tamamlanan=${completed}, aktif=${active}, başarısız=${failed}, başarı=%${(completionRatio*100).toFixed(2)}, hata=%${(failureRatio*100).toFixed(2)}.`
    );

    if(total>=20 && completionRatio<0.50 && active===0){
      console.warn(
        '[Campaign Engine] Aktif alıcı bulunmamasına rağmen kampanya tamamlanma oranı düşük.'
      );
    }
  }catch(reason){
    const message=reason instanceof Error
      ?reason.message
      :'Tamamlanma oranı kontrolü başarısız.';

    console.error(`[Campaign Engine] ${message}`);
  }
}

