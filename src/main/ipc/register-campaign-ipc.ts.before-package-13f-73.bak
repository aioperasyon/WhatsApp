}

function reportCampaignTerminalStateIntegrity(): void {
  const db=getDatabase();

  try{
    const row=db.prepare(`
      SELECT
        SUM(CASE WHEN status IN ('sent','delivered','read','failed','cancelled') THEN 1 ELSE 0 END) AS terminal_count,
        SUM(CASE WHEN status IN ('pending','sending') THEN 1 ELSE 0 END) AS active_count,
        COUNT(*) AS total_count
      FROM campaign_recipients
    `).get() as {
      terminal_count:number|null;
      active_count:number|null;
      total_count:number|null;
    };

    const terminal=Number(row.terminal_count??0);
    const active=Number(row.active_count??0);
    const total=Number(row.total_count??0);

    const difference=total-(terminal+active);

    console.info(
      `[Campaign Engine] Terminal durum kontrolü: terminal=${terminal}, aktif=${active}, toplam=${total}, fark=${difference}.`
    );

    if(difference!==0){
      console.warn(
        `[Campaign Engine] Terminal durum sayıları toplam kayıt ile uyuşmuyor: fark=${difference}.`
      );
    }
  }catch(reason){
    const message=reason instanceof Error?reason.message:'Terminal durum kontrolü başarısız.';
    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignProcessingBalance(): void {
  const db=getDatabase();
  try{
    const row=db.prepare(`
      SELECT
        SUM(CASE WHEN status='pending' THEN 1 ELSE 0 END) pending,
        SUM(CASE WHEN status='sending' THEN 1 ELSE 0 END) sending,
        SUM(CASE WHEN status='failed' THEN 1 ELSE 0 END) failed,
