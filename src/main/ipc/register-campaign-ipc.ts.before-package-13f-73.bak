    console.warn(
      `[Campaign Engine] Aynı kampanyada yinelenen telefon grubu tespit edildi: ${duplicateGroups}.`
    );
  }catch(reason){
    const message=reason instanceof Error?reason.message:'Yinelenen alıcı kontrolü başarısız.';
    console.error(`[Campaign Engine] ${message}`);
  }
}

function reportCampaignTimestampIntegrity(): void {
  const database = getDatabase();

  try {
    const row = database
      .prepare(
        `SELECT
           SUM(
             CASE
               WHEN created_at IS NULL
                 OR TRIM(created_at) = ''
               THEN 1
               ELSE 0
             END
           ) AS missing_created_at,
           SUM(
             CASE
               WHEN updated_at IS NULL
                 OR TRIM(updated_at) = ''
               THEN 1
               ELSE 0
             END
           ) AS missing_updated_at,
           SUM(
             CASE
               WHEN created_at IS NOT NULL
                AND updated_at IS NOT NULL
                AND datetime(updated_at) < datetime(created_at)
               THEN 1
               ELSE 0
             END
           ) AS reversed_timestamps,
           SUM(
             CASE
               WHEN created_at IS NOT NULL
                AND datetime(created_at) > datetime('now', '+5 minutes')
               THEN 1
               ELSE 0
             END
           ) AS future_created_at
         FROM campaign_recipients`,
      )
      .get() as {
        missing_created_at: number | null;
        missing_updated_at: number | null;
        reversed_timestamps: number | null;
        future_created_at: number | null;
      };

    const missingCreatedAt = Number(
      row.missing_created_at ?? 0,
    );
    const missingUpdatedAt = Number(
      row.missing_updated_at ?? 0,
    );
    const reversedTimestamps = Number(
      row.reversed_timestamps ?? 0,
    );
    const futureCreatedAt = Number(
      row.future_created_at ?? 0,
    );

    if (
      missingCreatedAt === 0 &&
      missingUpdatedAt === 0 &&
      reversedTimestamps === 0 &&
      futureCreatedAt === 0
    ) {
      console.info(
        '[Campaign Engine] Zaman damgası bütünlüğü kontrolü başarılı.',
      );

      return;
    }

    console.warn(
      `[Campaign Engine] Zaman damgası anomalisi: created_at eksik=${missingCreatedAt}, updated_at eksik=${missingUpdatedAt}, ters zaman sırası=${reversedTimestamps}, gelecekte oluşturulmuş=${futureCreatedAt}.`,
    );
  } catch (reason: unknown) {
    const message =
      reason instanceof Error
        ? reason.message
        : 'Zaman damgası bütünlüğü kontrolü gerçekleştirilemedi.';

    console.error(
      `[Campaign Engine] Zaman damgası bütünlüğü kontrolü başarısız: ${message}`,
    );
  }
}

function reportCampaignStatusIntegrity(): void {
